{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "chatze-nepal-new5",
  "main": "worker.js",
  "compatibility_date": "2024-09-23",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "chatze_db","database_id": "45a6e260-db35-40e6-a750-32f4be4585bf"
    }
  ],

  "vars": {
    "NODE_ENV": "production",
    "BETTER_AUTH_SECRET": "chatze-cloudflare-edge-secret-key-prod-np",
    "PUBLIC_APP_URL": "https://chatze-nepal.workers.dev"
  },
  "assets": {
    "directory": ".next",
    "binding": "ASSETS"
  }
}
